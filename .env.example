# Copy this file to `.env` and adjust as needed.
# The app and scraper read DATABASE_URL from the environment (or this .env file).

# Local Postgres (docker-compose.yml)
DATABASE_URL=postgresql+psycopg://hockey:hockey@localhost:5432/hockey_calgary

# Example Neon URL for future use:
# DATABASE_URL=postgresql+psycopg://USER:PASSWORD@ep-xxxx-pooler.us-east-2.aws.neon.tech/hockey_calgary?sslmode=require
